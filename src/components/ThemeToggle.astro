---
const buttonClass =
    "rounded-full px-3 py-1.5 text-sm font-medium text-brand-muted transition hover:text-brand-ink focus:outline-none focus:ring-2 focus:ring-brand-secondary/40 data-[active=true]:bg-brand-ink data-[active=true]:text-brand-page data-[active=true]:shadow-sm dark:text-brand-dark-fg/70 dark:hover:text-brand-dark-fg dark:data-[active=true]:bg-brand-dark-fg dark:data-[active=true]:text-brand-dark-bg";
---

<div
    class="inline-flex items-center gap-1 rounded-full border border-brand-border bg-brand-surface p-1 shadow-sm backdrop-blur-sm dark:border-brand-dark-fg/15 dark:bg-brand-dark-fg/5"
    data-theme-toggle
    role="group"
    aria-label="Theme preference"
>
    <button type="button" class={buttonClass} data-theme-option="system" data-active="false" aria-pressed="false">
        System
    </button>
    <button type="button" class={buttonClass} data-theme-option="light" data-active="false" aria-pressed="false">
        Light
    </button>
    <button type="button" class={buttonClass} data-theme-option="dark" data-active="false" aria-pressed="false">
        Dark
    </button>
</div>

<script is:inline>
    const toggle = document.querySelector("[data-theme-toggle]");

    if (toggle) {
        const buttons = Array.from(toggle.querySelectorAll("[data-theme-option]"));

        const syncButtons = () => {
            const activePreference = document.documentElement.dataset.themePreference ?? "system";

            buttons.forEach((button) => {
                const isActive = button.dataset.themeOption === activePreference;

                button.setAttribute("aria-pressed", String(isActive));
                button.dataset.active = String(isActive);
            });
        };

        buttons.forEach((button) => {
            button.addEventListener("click", () => {
                window.__setThemePreference?.(button.dataset.themeOption ?? "system");
            });
        });

        syncButtons();
        document.addEventListener("themechange", syncButtons);
    }
</script>
